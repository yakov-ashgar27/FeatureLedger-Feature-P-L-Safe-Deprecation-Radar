POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=app_dev_password
# true  = demo mode: load the Northwind Cloud sample company on first start
# false = real-data mode: create YOUR organization from features.yaml (set the two lines below)
SEED_ON_START=true
DEFAULT_ORG_SLUG=northwind
ORG_NAME=My Company
# Optional: require a bearer token on every API call (the dashboard forwards it server-side)
FL_API_TOKEN=
# Optional: read-only fine-grained token (Pull requests: read, Contents: read) to ingest a real repo
GITHUB_TOKEN=

# ---------------------------------------------------------------- Phase 2: connectors
# true  = the five connectors read realistic sandbox APIs built from the demo company (no accounts needed)
# false = live APIs: fill in the credentials below for each source you want to connect
SANDBOX_MODE=true
CONNECTOR_BACKFILL_MONTHS=6
# FX for non-USD Stripe prices, e.g. {"eur": 1.08, "gbp": 1.27}
FX_RATES_TO_USD={}

# Stripe: Developers > API keys > restricted key with READ on Customers, Subscriptions, Invoices, Events
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Jira Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=
JIRA_WEBHOOK_SECRET=

# PostHog: Settings > Personal API keys (scopes: query:read, group:read); group type 0 = company
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_GROUP_TYPE_INDEX=0

# Zendesk: Admin Center > Apps and integrations > Zendesk API > token access
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# optional: the Time Tracking app's "Total time spent (sec)" ticket field id (else replies x 12 min)
ZENDESK_TIME_SPENT_FIELD_ID=
ZENDESK_WEBHOOK_SECRET=

# AWS Cost Explorer: IAM user/role with ce:GetCostAndUsage; activate the `feature` cost allocation tag
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CE_TAG_KEY=feature

# ---------------------------------------------------------------- Phase 3: Feature Graph
# Optional. With LLM_API_KEY AND LLM_ALLOW_EXTERNAL=true: OpenAI-compatible embeddings + one-line
# rationales for Tier 3. That sends ticket / PR / message text to LLM_BASE_URL, so it needs both.
# Otherwise: a deterministic local embedder and template rationales (no data leaves the box).
LLM_API_KEY=
LLM_ALLOW_EXTERNAL=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# features.yaml sync on push: GitHub repo > Settings > Webhooks > Add webhook
#   Payload URL: https://<your-host>/api/v1/webhooks/github/<github integration id>, content type JSON,
#   secret = the value below, events: "Just the push event". GITHUB_TOKEN (read-only Contents) fetches the file.
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Phase 4: sign-in (SSO + roles)
# Browser URL of the dashboard. The SSO redirect URI to register at your IdP is
#   ${APP_URL}/api/v1/auth/oidc/callback
APP_URL=http://localhost:3000
# Signs session cookies. With SANDBOX_MODE=false the API, worker and migrations REFUSE TO START unless this is
# at least 32 characters (and DEMO_MODE=false). Generate with:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# One-click sign-in as each role. Only works while SANDBOX_MODE=true; never in production.
AUTH_DEV_LOGIN=true
# Enterprise SSO (OpenID Connect, authorization code + PKCE). OIDC_PROVIDER: okta | google | auth0 | generic
#   Okta:   OIDC_ISSUER=https://<your-org>.okta.com/oauth2/default   (role claim: groups)
#   Google: OIDC_ISSUER is preset; set OIDC_ALLOWED_DOMAINS=yourcompany.com   (roles assigned in FeatureLedger)
#   Auth0:  OIDC_ISSUER=https://<tenant>.us.auth0.com/   (role claim: https://featureledger.app/roles, via an Action)
OIDC_PROVIDER=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
# IdP group -> FeatureLedger role, e.g. FL-Admins=admin,FL-Product=pm_tech_lead,FL-CS=cs_lead
# (roles: viewer, pm_tech_lead, cs_lead, admin). Unmatched users get OIDC_DEFAULT_ROLE.
OIDC_ROLE_MAP=
OIDC_DEFAULT_ROLE=viewer
OIDC_ALLOWED_DOMAINS=
# First admins of a fresh install (comma-separated). Created as admins of your org at startup (real-data mode);
# SSO keeps them admin. On a laptop with SANDBOX_MODE=true, sign in with the "Admin" dev-login button.
BOOTSTRAP_ADMIN_EMAILS=

# ---------------------------------------------------------------- Phase 4: Safe Sunset execution
# Feature flags the canary drives. Empty = LaunchDarkly/Statsig if a key below is set, else sandbox.
FLAG_PROVIDER=
# which account id your flag contexts use: external_ref (the Stripe customer id) or id
FLAG_ACCOUNT_KEY=external_ref
# LaunchDarkly: Account settings > Authorization > access token with a Writer role on the project
LAUNCHDARKLY_API_TOKEN=
LAUNCHDARKLY_PROJECT_KEY=default
LAUNCHDARKLY_ENVIRONMENT_KEY=production
LAUNCHDARKLY_CONTEXT_KIND=account
# Statsig: Project settings > Keys > Console API key; exposures via an Event Webhook to
#   ${APP_URL}/api/v1/flags/webhooks/statsig?org=<org slug>   signed with STATSIG_WEBHOOK_SECRET
STATSIG_CONSOLE_API_KEY=
STATSIG_ID_TYPE=accountID
STATSIG_WEBHOOK_SECRET=
# Cleanup PRs: a SEPARATE fine-grained token (Contents + Pull requests: read & write) on this repo only.
# The ingest GITHUB_TOKEN stays read-only. Merge events arrive on the GitHub webhook above
# (add the "Pull requests" event to it).
GITHUB_CLEANUP_TOKEN=
SUNSET_CLEANUP_REPO=
SUNSET_CLEANUP_BASE=

# ---------------------------------------------------------------- Phase 5
# Public "Launch Live Demo (Acme Cloud — 45 Engineers)" button: an isolated, resettable demo tenant that
# only ever uses sandbox providers. Must be false when SANDBOX_MODE=false (startup is refused otherwise).
DEMO_MODE=true
# Executive digest: Slack incoming webhook (Slack app > Incoming Webhooks). Never posts while SANDBOX_MODE=true.
SLACK_WEBHOOK_URL=
# Zombie-Guard PR comments: fine-grained token with Pull requests: read & write (falls back to
# GITHUB_CLEANUP_TOKEN). Without one the comments stay in FeatureLedger (Zombie-Guard page).
GITHUB_COMMENT_TOKEN=

# ---------------------------------------------------------------- Hardening
# Rate limits: login / SSO / demo sessions 30 per minute per address, API 1200 per minute per session.
RATE_LIMIT_ENABLED=true
# Proxies in front of the API that append to X-Forwarded-For: 1 = the dashboard only, 2 = a load
# balancer in front of it. Do not expose the API port publicly, or that header can be forged.
TRUSTED_PROXY_HOPS=1
# The shared live demo may be reset at most once per this many seconds.
DEMO_RESET_COOLDOWN_S=60
