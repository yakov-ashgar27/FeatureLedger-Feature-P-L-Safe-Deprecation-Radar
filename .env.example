POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=app_dev_password
# true  = demo mode: load the Northwind Cloud sample company on first start
# false = real-data mode: create YOUR organization from features.yaml (set the two lines below)
SEED_ON_START=true
DEFAULT_ORG_SLUG=northwind
ORG_NAME=My Company
# Optional: require a bearer token on every API call (the dashboard forwards it server-side)
FL_API_TOKEN=
# Optional: read-only fine-grained token (Pull requests: read, Contents: read) to ingest a real repo
GITHUB_TOKEN=
